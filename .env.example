# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenAI-compatible provider (for example MiniMax)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Runtime overrides used by main.py
TA_LLM_PROVIDER=openai
TA_BACKEND_URL=
TA_MODEL=
TA_DEEP_MODEL=
TA_QUICK_MODEL=
TA_MAX_DEBATE_ROUNDS=1

# Optional: per-category data vendor chain (comma-separated, left-to-right fallback)
# If TA_DATA_VENDOR is set, it can still be used as a global fallback.
TA_DATA_VENDOR=
TA_DATA_VENDOR_CORE=stooq,yfinance,alpha_vantage,local
TA_DATA_VENDOR_TECH=alpha_vantage,yfinance,local
TA_DATA_VENDOR_FUND=yfinance,alpha_vantage
TA_DATA_VENDOR_NEWS=seeking_alpha,yfinance,alpha_vantage
# Optional ticker mapping for Seeking Alpha feed lookup (JSON object)
# Example: {"0700.HK":"TCEHY","9988.HK":"BABA"}
TA_SEEKING_ALPHA_SYMBOL_OVERRIDES=
TA_SA_MIN_ITEMS=2
TA_SA_STRICT_COVERAGE=true

# Optional: local data directory for Wind-exported CSV files
# Example: /Users/you/Documents/wind_csv
TRADINGAGENTS_LOCAL_DATA_DIR=
